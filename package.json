{
  "name": "job-agent",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node -e \"require('./dist/api/bootstrap'); require('./dist/index')\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:local-enrichment-lifecycle": "bash scripts/test-local-enrichment-lifecycle.sh",
    "verify": "npm run typecheck && npm run build && npm test -- --runInBand",
    "verify:discovery": "tsx scripts/verify-job-sources.ts",
    "dry-run": "tsx scripts/dry-run-application.ts",
    "dry-run:recruiters": "tsx scripts/dry-run-recruiter-discovery.ts",
    "dry-run:recruiter-outreach": "tsx scripts/dry-run-recruiter-outreach.ts",
    "phase5:controlled-runtime": "tsx scripts/phase5-controlled-runtime.ts",
    "phase6:controlled-gmail": "bash scripts/local-app-script.sh scripts/phase6-controlled-gmail-runtime.ts",
    "phase7:recruiter-outreach-runtime": "bash scripts/local-app-script.sh scripts/phase7-recruiter-outreach-runtime.ts",
    "phase8:recruiter-first-runtime": "bash scripts/local-app-script.sh scripts/phase8-recruiter-first-runtime.ts",
    "phase10:readiness": "tsx scripts/phase10-readiness.ts",
    "phase10:controlled-live-recruiter": "bash scripts/local-app-script.sh scripts/phase10-controlled-live-recruiter.ts",
    "list:phase6-eligible-outreach": "bash scripts/local-app-script.sh scripts/list-phase6-eligible-outreach.ts",
    "preflight:recruiter-outreach": "tsx scripts/preflight-recruiter-outreach.ts",
    "preflight:autonomous": "tsx scripts/preflight-autonomous-runtime.ts",
    "reconcile:recruiter-outreach": "bash scripts/local-app-script.sh scripts/reconcile-recruiter-outreach.ts",
    "reconcile:gmail-outreach": "bash scripts/local-app-script.sh scripts/reconcile-gmail-outreach.ts",
    "requeue:recruiter-discovery": "tsx scripts/requeue-recruiter-discovery.ts",
    "doctor": "tsx scripts/doctor.ts",
    "discover:once": "tsx src/scripts/discover-once.ts",
    "platform-federation:once": "bash scripts/local-app-script.sh scripts/platform-federation-once.ts",
    "matching:once": "bash scripts/local-app-script.sh scripts/process-matching-once.ts",
    "proactive-recruiter:once": "bash scripts/local-app-script.sh scripts/proactive-recruiter-final-once.ts",
    "gmail:authorize": "tsx scripts/gmail-authorize.ts",
    "gmail:verify": "tsx scripts/gmail-verify.ts",
    "gmail:smoke-send": "tsx scripts/gmail-smoke-send.ts",
    "outcome:fast-jobs": "tsx scripts/fast-outcome-jobs.ts",
    "diagnostics:fast-jobs": "tsx scripts/fast-job-diagnostics.ts",
    "content-first:once": "bash scripts/local-app-script.sh scripts/content-first-final-once.ts",
    "public-contact-resources:once": "bash scripts/local-app-script.sh scripts/linkedin-hiring-post-resources-once.ts && bash scripts/local-app-script.sh scripts/promote-public-contact-resources-once.ts && bash scripts/local-app-script.sh scripts/promote-recruiter-public-contacts-once.ts && bash scripts/local-app-script.sh scripts/supplement-public-job-contact-resources-once.ts",
    "application-email:once": "tsx scripts/application-email-outcome-once.ts",
    "platform-coverage": "bash scripts/local-app-script.sh scripts/platform-coverage-report.ts",
    "cleanup:irrelevant-jobs": "tsx scripts/cleanup-irrelevant-jobs.ts",
    "repair:job-bridge": "tsx scripts/repair-opportunity-job-bridge.ts",
    "typecheck:scripts": "tsc --noEmit --target ES2022 --module CommonJS --moduleResolution Node --strict --esModuleInterop --skipLibCheck --noUncheckedIndexedAccess --noImplicitOverride src/types/pg.d.ts scripts/fast-outcome-jobs.ts scripts/proactive-recruiter-once.ts scripts/proactive-recruiter-final-once.ts scripts/linkedin-hiring-post-once.ts scripts/supplement-proactive-recruiters-once.ts scripts/public-contact-resources-once.ts scripts/supplement-public-job-contact-resources-once.ts scripts/promote-public-contact-resources-once.ts scripts/public-hiring-posts-once.ts scripts/linkedin-hiring-post-resources-once.ts scripts/content-first-final-once.ts scripts/platform-federation-once.ts scripts/cleanup-irrelevant-jobs.ts scripts/repair-opportunity-job-bridge.ts",
    "local:run": "test -f .env || touch .env; bash scripts/local-run.sh",
    "local:watch": "bash scripts/local-watch.sh",
    "local:status": "bash scripts/local-status.sh",
    "local:stop": "bash scripts/local-stop.sh",
    "local:restart": "bash scripts/local-restart.sh"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "pg": "^8.16.3",
    "pino": "^9.9.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.1.3",
    "playwright": "^1.63.0",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
