{
  "name": "job-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Personal job-search automation system",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "dry-run": "tsx scripts/dry-run-application.ts",
    "dry-run:recruiters": "tsx scripts/dry-run-recruiter-discovery.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "playwright": "^1.63.0"
  }
}
