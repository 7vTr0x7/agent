# Core runtime
NODE_ENV=development
LOG_LEVEL=info
AUTOMATION_ENABLED=false
APPLICATION_DRY_RUN=true
OUTBOUND_ENABLED=false
JOB_DISCOVERY_ENABLED=true
JOB_DISCOVERY_INTERVAL_MS=900000
APPLICATION_QUEUE_INTERVAL_MS=30000
STALE_SUBMISSION_CHECK_INTERVAL_MS=300000
STALE_SUBMISSION_THRESHOLD_MINUTES=30
FOLLOW_UP_INTERVAL_MS=300000
INTERVIEW_REMINDER_INTERVAL_MS=300000
JOB_SOURCES=
GENERIC_APPLICATION_ADAPTER_ENABLED=false
APPLICATION_RATE_LIMIT_PER_DAY=50
APPLICATION_COMPANY_RATE_LIMIT_PER_DAY=5
CANDIDATE_PROFILE_ID=

# Database
DATABASE_URL=

# Gmail
GMAIL_ENABLED=false
GMAIL_ACCOUNT_TIER=consumer
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=
GMAIL_SYNC_QUERY=newer_than:14d -from:me
GMAIL_SYNC_INTERVAL_MS=120000

# Notifications
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=

# Resume tailoring
RESUME_TAILORING_ENABLED=false
RESUME_MASTER_PATH=
RESUME_OUTPUT_DIRECTORY=./data/resumes

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=120000

# Recruiter discovery + outreach
RECRUITER_OUTREACH_ENABLED=false
RECRUITER_OUTREACH_DRY_RUN=true
# disabled = no real recruiter delivery; canary = exactly 1/day and 1/hour; live = explicit confirmation required.
RECRUITER_OUTREACH_ACTIVATION=disabled
RECRUITER_LIVE_ACTIVATION_CONFIRMED=false
RECRUITER_DISCOVERY_PROVIDER=job-posting
RECRUITER_MIN_CONFIDENCE=80
RECRUITER_REQUIRE_VERIFIED_EMAIL=true
RECRUITER_MAX_CONTACTS_PER_APPLICATION=3
# Gmail daily ceilings: consumer Gmail=500; Google Workspace=2000.
# Set GMAIL_ACCOUNT_TIER=workspace only when this sender is actually a Workspace account.
RECRUITER_MAX_MESSAGES_PER_DAY=500
RECRUITER_MAX_MESSAGES_PER_HOUR=21
RECRUITER_FOLLOWUP_ENABLED=false
RECRUITER_FOLLOWUP_DAY_OFFSETS=4,10,18
RECRUITER_GENERIC_EMAIL_FALLBACK=true
HUNTER_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
