NODE_ENV=development
LOG_LEVEL=info
JOB_DISCOVERY_ENABLED=true
JOB_DISCOVERY_INTERVAL_MS=900000
APPLICATION_QUEUE_INTERVAL_MS=30000
STALE_SUBMISSION_CHECK_INTERVAL_MS=300000
STALE_SUBMISSION_THRESHOLD_MINUTES=30
FOLLOW_UP_INTERVAL_MS=300000
INTERVIEW_REMINDER_INTERVAL_MS=300000
JOB_SOURCES=
AUTOMATION_ENABLED=false
APPLICATION_DRY_RUN=true
GENERIC_APPLICATION_ADAPTER_ENABLED=false
APPLICATION_RATE_LIMIT_PER_DAY=50
APPLICATION_COMPANY_RATE_LIMIT_PER_DAY=5
RESUME_TAILORING_ENABLED=false
RESUME_MASTER_PATH=./data/master-resume.json
RESUME_OUTPUT_DIRECTORY=./data/resumes
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=120000
DATABASE_URL=postgresql://job_agent:job_agent@localhost:5432/job_agent
JOB_TARGET_COUNTRIES=India
JOB_PRIORITY_LOCATIONS=Bangalore,Bengaluru
JOB_ALLOW_REMOTE=true
JOB_MAX_AGE_DAYS=0
JOB_EXCLUDED_COMPANIES=Octopus Technologies,Sketch Brahma Technologies
CANDIDATE_PROFILE_ID=default-candidate
CANDIDATE_YEARS_EXPERIENCE=3
CANDIDATE_SKILLS=React.js,Next.js,JavaScript,TypeScript,Redux Toolkit,Tailwind CSS,Node.js,Express.js,MongoDB
CANDIDATE_TARGET_TITLES=Frontend Engineer,Frontend Developer,Full Stack Engineer
CANDIDATE_FIRST_NAME=
CANDIDATE_LAST_NAME=
CANDIDATE_FULL_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_LOCATION=Bengaluru
CANDIDATE_WORK_AUTHORIZATION=
CANDIDATE_SPONSORSHIP_REQUIRED=
CANDIDATE_NOTICE_PERIOD_DAYS=
CANDIDATE_LINKEDIN_URL=
CANDIDATE_GITHUB_URL=
CANDIDATE_PORTFOLIO_URL=
CANDIDATE_RESUME_PATH=
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
OUTBOUND_ENABLED=false

# Recruiter discovery: no Hunter account is required for the default public-job-posting path.
# Snov is an optional second provider; it can be configured later with SNOV_CLIENT_ID/SECRET.
RECRUITER_OUTREACH_ENABLED=false
RECRUITER_OUTREACH_DRY_RUN=true
RECRUITER_DISCOVERY_PROVIDER=job-posting
HUNTER_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
RECRUITER_MIN_CONFIDENCE=80
RECRUITER_REQUIRE_VERIFIED_EMAIL=true
RECRUITER_MAX_CONTACTS_PER_APPLICATION=3
RECRUITER_MAX_MESSAGES_PER_DAY=499
RECRUITER_MAX_MESSAGES_PER_HOUR=15
RECRUITER_FOLLOWUP_ENABLED=false
RECRUITER_FOLLOWUP_DAY_OFFSETS=4,10,18
RECRUITER_GENERIC_EMAIL_FALLBACK=true

GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=
GMAIL_SYNC_QUERY=newer_than:14d -from:me
GMAIL_SYNC_INTERVAL_MS=120000
