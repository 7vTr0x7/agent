# Core runtime
NODE_ENV=production
LOG_LEVEL=info
AUTOMATION_ENABLED=false
APPLICATION_DRY_RUN=true
OUTBOUND_ENABLED=false
JOB_DISCOVERY_ENABLED=true
JOB_DISCOVERY_INTERVAL_MS=900000
JOB_MAX_AGE_DAYS=7
APPLICATION_QUEUE_INTERVAL_MS=30000
STALE_SUBMISSION_CHECK_INTERVAL_MS=300000
STALE_SUBMISSION_THRESHOLD_MINUTES=30
STALE_SUBMISSION_RECONCILIATION_ENABLED=false
FOLLOW_UP_INTERVAL_MS=300000
INTERVIEW_REMINDER_INTERVAL_MS=300000
JOB_SOURCES=
GENERIC_APPLICATION_ADAPTER_ENABLED=true
API_HOST=127.0.0.1
API_PORT=3000
APPLICATION_RATE_LIMIT_PER_DAY=200
APPLICATION_COMPANY_RATE_LIMIT_PER_DAY=20

# Proactive recruiter discovery. Disabled by default; sending remains independently disabled.
PROACTIVE_RECRUITER_ENABLED=false
PROACTIVE_RECRUITER_SEND_ENABLED=false
PROACTIVE_RECRUITER_INTERVAL_MS=21600000
PROACTIVE_RECRUITER_MAX_CANDIDATES_PER_RUN=50

# Broad job discovery (optional; no secrets committed)
TECHMAP_ENABLED=true
TECHMAP_RAPIDAPI_KEY=
TECHMAP_CITY=Bengaluru
TECHMAP_TITLE=React OR Frontend OR "Front End" OR Next.js OR TypeScript
TECHMAP_SKILLS=Javascript,Typescript,React,Next.js
TECHMAP_RESULTS_PER_PAGE=50
TECHMAP_DATE_CREATED=
TECHMAP_PORTALS=
ADZUNA_ENABLED=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_QUERIES=React,Frontend Engineer,Front End Developer,Next.js,TypeScript
ADZUNA_LOCATIONS=Bengaluru,India
JOOBLE_ENABLED=true
JOOBLE_API_KEY=
JOOBLE_API_BASE_URL=https://in.jooble.org/api

# Docker/PostgreSQL
POSTGRES_DB=job_agent
POSTGRES_USER=job_agent
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://job_agent:change-this-local-password@postgres:5432/job_agent

# Candidate profile
CANDIDATE_PROFILE_ID=salman
CANDIDATE_YEARS_EXPERIENCE=3
CANDIDATE_SKILLS=React.js,Next.js,JavaScript,TypeScript,Redux Toolkit,Tailwind CSS,HTML,CSS,Node.js,Express.js,MongoDB,Docker,Git,GitHub,Jest,React Testing Library
CANDIDATE_TARGET_TITLES=Frontend Engineer,Frontend Developer,React Developer,React.js Developer,Full Stack Developer,Full Stack Engineer
CANDIDATE_FIRST_NAME=
CANDIDATE_LAST_NAME=
CANDIDATE_FULL_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_LOCATION=India
CANDIDATE_PREFERRED_LOCATIONS=Bengaluru,Bangalore,India,Remote
CANDIDATE_REMOTE_ELIGIBLE=true
CANDIDATE_WORK_AUTHORIZATION=
CANDIDATE_SPONSORSHIP_REQUIRED=false
CANDIDATE_NOTICE_PERIOD_DAYS=15
CANDIDATE_LINKEDIN_URL=
CANDIDATE_GITHUB_URL=
CANDIDATE_PORTFOLIO_URL=
CANDIDATE_RESUME_PATH=
CANDIDATE_STANDARDIZED_ANSWERS_JSON=

# Gmail. Safe default is OFF. OAuth credentials must never be committed.
GMAIL_ENABLED=false
GMAIL_ACCOUNT_TIER=consumer
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=
GMAIL_SYNC_QUERY=newer_than:14d -from:me
GMAIL_SYNC_INTERVAL_MS=120000

# Notifications
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=

# Resume tailoring
RESUME_TAILORING_ENABLED=false
RESUME_MASTER_PATH=
RESUME_OUTPUT_DIRECTORY=./data/resumes

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_KEEP_ALIVE=10m

# Recruiter discovery + outreach. All outbound controls remain OFF by default.
RECRUITER_OUTREACH_ENABLED=false
RECRUITER_OUTREACH_DRY_RUN=true
RECRUITER_OUTREACH_ACTIVATION=disabled
RECRUITER_LIVE_ACTIVATION_CONFIRMED=false
RECRUITER_CONTROLLED_SEND_CONFIRM=
RECRUITER_CONTROLLED_MESSAGE_ID=
RECRUITER_CONTROLLED_RECIPIENT=
RECRUITER_DISCOVERY_PROVIDER=public-web
RECRUITER_MIN_CONFIDENCE=80
RECRUITER_REQUIRE_VERIFIED_EMAIL=true
RECRUITER_MAX_CONTACTS_PER_APPLICATION=3
RECRUITER_MAX_MESSAGES_PER_DAY=200
RECRUITER_MAX_MESSAGES_PER_HOUR=9
RECRUITER_FOLLOWUP_ENABLED=true
RECRUITER_FOLLOWUP_DAY_OFFSETS=4,10,18
RECRUITER_GENERIC_EMAIL_FALLBACK=false
RECRUITER_ATTACH_RESUME=true
RECRUITER_MAX_ATTACHMENT_BYTES=10485760
