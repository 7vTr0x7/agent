NODE_ENV=development
LOG_LEVEL=info

# Keep false until you explicitly want the application worker to submit jobs.
AUTOMATION_ENABLED=false

# Broad generic-form automation is intentionally disabled by default.
# Enable only for controlled testing; production should use platform-specific adapters.
GENERIC_APPLICATION_ADAPTER_ENABLED=false

# Tailor a fresh ATS-oriented resume per job from the master resume facts.
# Keep false until RESUME_MASTER_PATH points to your verified master resume JSON.
RESUME_TAILORING_ENABLED=false
RESUME_MASTER_PATH=./data/master-resume.json
RESUME_OUTPUT_DIRECTORY=./data/resumes

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=120000

DATABASE_URL=postgresql://job_agent:job_agent@localhost:5432/job_agent

JOB_TARGET_COUNTRIES=India
JOB_PRIORITY_LOCATIONS=Bangalore,Bengaluru
JOB_ALLOW_REMOTE=true
JOB_MAX_AGE_DAYS=0
JOB_EXCLUDED_COMPANIES=Octopus Technologies,Sketch Brahma Technologies

# Candidate profile used by the application worker
CANDIDATE_PROFILE_ID=default-candidate
CANDIDATE_YEARS_EXPERIENCE=3
CANDIDATE_SKILLS=React.js,Next.js,JavaScript,TypeScript,Redux Toolkit,Tailwind CSS,Node.js,Express.js,MongoDB
CANDIDATE_TARGET_TITLES=Frontend Engineer,Frontend Developer,Full Stack Engineer
CANDIDATE_FIRST_NAME=
CANDIDATE_LAST_NAME=
CANDIDATE_FULL_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_LOCATION=Bengaluru
CANDIDATE_WORK_AUTHORIZATION=
CANDIDATE_SPONSORSHIP_REQUIRED=
CANDIDATE_NOTICE_PERIOD_DAYS=
CANDIDATE_LINKEDIN_URL=
CANDIDATE_GITHUB_URL=
CANDIDATE_PORTFOLIO_URL=
CANDIDATE_RESUME_PATH=

# Outbound application notifications are disabled until explicitly configured.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=

# Gmail recruiter-response monitoring. Keep false until a Google OAuth refresh token is configured.
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=
GMAIL_SYNC_QUERY=newer_than:14d -from:me
GMAIL_SYNC_INTERVAL_MS=120000
