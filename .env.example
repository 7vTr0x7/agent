NODE_ENV=development
LOG_LEVEL=info

# Job discovery is safe to run independently; it only collects, matches and ranks jobs.
JOB_DISCOVERY_ENABLED=true
JOB_DISCOVERY_INTERVAL_MS=900000

# Application queue polling interval. Keep conservative to avoid unnecessary database churn.
APPLICATION_QUEUE_INTERVAL_MS=30000

# Stale submission inspection is read-only and never retries or changes application state.
STALE_SUBMISSION_CHECK_INTERVAL_MS=300000
STALE_SUBMISSION_THRESHOLD_MINUTES=30

# Follow-up draft preparation and interview reminder polling intervals.
FOLLOW_UP_INTERVAL_MS=300000
INTERVIEW_REMINDER_INTERVAL_MS=300000

# JSON array of approved job sources. Leave empty until source credentials/feeds are configured.
# Example: [{"id":"example-greenhouse","type":"ats","name":"Greenhouse","boardToken":"example"}]
JOB_SOURCES=

# Keep false until you explicitly want the application worker to run.
AUTOMATION_ENABLED=false

# Safety default: browser application workflows run as dry runs and NEVER submit while this is true.
# Set to false only after controlled real-world ATS validation and a final safety review.
APPLICATION_DRY_RUN=true

# Broad generic-form automation is intentionally disabled by default.
# Enable only for controlled testing; production should use platform-specific adapters.
GENERIC_APPLICATION_ADAPTER_ENABLED=false

# Hard safety ceiling for successfully submitted applications per candidate per calendar day.
# Keep conservative; the queue will stop adding new application tasks after this limit.
APPLICATION_RATE_LIMIT_PER_DAY=50

# Additional safety ceiling for successfully submitted applications to one company per candidate per calendar day.
APPLICATION_COMPANY_RATE_LIMIT_PER_DAY=5

# Tailor a fresh ATS-oriented resume per job from the master resume facts.
# Keep false until RESUME_MASTER_PATH points to your verified master resume JSON.
RESUME_TAILORING_ENABLED=false
RESUME_MASTER_PATH=./data/master-resume.json
RESUME_OUTPUT_DIRECTORY=./data/resumes

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=120000

DATABASE_URL=postgresql://job_agent:job_agent@localhost:5432/job_agent

JOB_TARGET_COUNTRIES=India
JOB_PRIORITY_LOCATIONS=Bangalore,Bengaluru
JOB_ALLOW_REMOTE=true
JOB_MAX_AGE_DAYS=0
JOB_EXCLUDED_COMPANIES=Octopus Technologies,Sketch Brahma Technologies

# Candidate profile used by the application worker
CANDIDATE_PROFILE_ID=default-candidate
CANDIDATE_YEARS_EXPERIENCE=3
CANDIDATE_SKILLS=React.js,Next.js,JavaScript,TypeScript,Redux Toolkit,Tailwind CSS,Node.js,Express.js,MongoDB
CANDIDATE_TARGET_TITLES=Frontend Engineer,Frontend Developer,Full Stack Engineer
CANDIDATE_FIRST_NAME=
CANDIDATE_LAST_NAME=
CANDIDATE_FULL_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_LOCATION=Bengaluru
CANDIDATE_WORK_AUTHORIZATION=
CANDIDATE_SPONSORSHIP_REQUIRED=
CANDIDATE_NOTICE_PERIOD_DAYS=
CANDIDATE_LINKEDIN_URL=
CANDIDATE_GITHUB_URL=
CANDIDATE_PORTFOLIO_URL=
CANDIDATE_RESUME_PATH=

# Outbound application notifications are disabled until explicitly configured.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=

# Recruiter outreach is fail-safe by default. Enable only after discovery, verification,
# suppression, deduplication and Gmail delivery have been validated in dry-run mode.
RECRUITER_OUTREACH_ENABLED=false
RECRUITER_OUTREACH_DRY_RUN=true
RECRUITER_DISCOVERY_PROVIDER=hunter
HUNTER_API_KEY=
RECRUITER_MIN_CONFIDENCE=80
RECRUITER_REQUIRE_VERIFIED_EMAIL=true
RECRUITER_MAX_CONTACTS_PER_APPLICATION=3
# Maximum recruiter messages per candidate per calendar day. 499 is the configured ceiling;
# runtime delivery safeguards should still throttle based on provider health and mailbox signals.
RECRUITER_MAX_MESSAGES_PER_DAY=499
RECRUITER_MAX_MESSAGES_PER_HOUR=15
RECRUITER_FOLLOWUP_ENABLED=false
RECRUITER_FOLLOWUP_DAY_OFFSETS=4,10,18
RECRUITER_GENERIC_EMAIL_FALLBACK=true

# Gmail recruiter-response monitoring. Keep false until a Google OAuth refresh token is configured.
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=
GMAIL_SYNC_QUERY=newer_than:14d -from:me
GMAIL_SYNC_INTERVAL_MS=120000
